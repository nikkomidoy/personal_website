# Production environment variables. On AWS these are set by the ECS task definition (see deploy/cloudformation.yml);
# secrets (DJANGO_SECRET_KEY, DB_PASSWORD) are injected from AWS Secrets Manager.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=www.example.com,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
WAGTAIL_SITE_NAME=My Career
WAGTAILADMIN_BASE_URL=https://www.example.com

# Database: either DATABASE_URL ...
# DATABASE_URL=postgres://user:pass@host:5432/careersite
# ... or discrete variables
DB_HOST=
DB_PORT=5432
DB_NAME=careersite
DB_USER=careersite
DB_PASSWORD=
DB_SSLMODE=require

# Media uploads on S3 (credentials come from the ECS task role)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=dxxxx.cloudfront.net

WEB_CONCURRENCY=3
